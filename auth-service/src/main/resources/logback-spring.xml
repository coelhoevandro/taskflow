<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Formato grep-friendly. Para rastrear uma requisição por todos os serviços:
        docker-compose logs | grep "correlationId=abc-123-def"
    -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="unknown"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [${APP_NAME}] [cid=%X{correlationId:--}] [uid=%X{userId:--}] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.taskflow" level="DEBUG"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

</configuration>
