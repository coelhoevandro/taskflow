    {
      "name": "Saga Demo",
      "description": "Run Auth > Login first, then these four requests in order. Watch the Postman console to follow the Kafka choreography: task-service emits task.assigned, notification-service creates the notification and replies with notification.result, and task-service confirms the assignment.",
      "item": [
        {
          "name": "1. Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const task = pm.response.json();",
                  "pm.collectionVariables.set(\"taskId\", task.id);",
                  "console.log(\"[saga] 1/4 task created: \" + task.id + \" (assignmentStatus=\" + task.assignmentStatus + \")\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Saga demo task\",\n  \"description\": \"Created by the Saga Demo folder\",\n  \"priority\": \"MEDIUM\",\n  \"reporterId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "2. Assign task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const assigned = pm.response.json();",
                  "pm.test(\"Saga started\", () => pm.expect(assigned.assignmentStatus).to.be.oneOf([\"PENDING_NOTIFICATION\", \"CONFIRMED\"]));",
                  "console.log(\"[saga] 2/4 task.assigned emitted, assignmentStatus=\" + assigned.assignmentStatus);",
                  "console.log(\"[saga] trace it with: docker-compose logs | grep cid=\" + pm.response.headers.get(\"X-Correlation-Id\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "assign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": \"{{assigneeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "3. Check assignment confirmed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const confirmed = pm.response.json();",
                  "pm.test(\"Assignment confirmed by notification.result\", () => pm.expect(confirmed.assignmentStatus).to.eql(\"CONFIRMED\"));",
                  "console.log(\"[saga] 3/4 assignmentStatus=\" + confirmed.assignmentStatus + (confirmed.assignmentStatus === \"CONFIRMED\" ? \"\" : \" (still in flight, send this request again)\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "The saga is asynchronous. If this still shows PENDING_NOTIFICATION, send the request again after a moment."
          },
          "response": []
        },
        {
          "name": "4. Assignee notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const notes = pm.response.json();",
                  "const mine = notes.filter(n => n.taskId === pm.collectionVariables.get(\"taskId\"));",
                  "pm.test(\"Notification was created for the task\", () => pm.expect(mine).to.have.lengthOf(1));",
                  "console.log(\"[saga] 4/4 notifications for this task: \" + mine.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/user/{{assigneeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications",
                "user",
                "{{assigneeId}}"
              ]
            }
          },
          "response": []
        }
      ]
