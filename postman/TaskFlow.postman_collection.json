    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const auth = pm.response.json();",
                  "pm.test(\"Returns access and refresh tokens\", () => {",
                  "    pm.expect(auth.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(auth.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", auth.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", auth.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", auth.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Run this first. Saves accessToken, refreshToken and userId as collection variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@taskflow.dev\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Returns the new user id\", () => pm.expect(pm.response.json().userId).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a new account. Tokens of the new user are not saved, so later requests keep running as the logged-in user.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.{{$timestamp}}@taskflow.dev\",\n  \"password\": \"demo123\",\n  \"name\": \"Demo User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const auth = pm.response.json();",
                  "pm.test(\"Returns access and refresh tokens\", () => {",
                  "    pm.expect(auth.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(auth.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", auth.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", auth.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", auth.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
